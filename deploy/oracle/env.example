# /opt/polymath/.env on the Oracle VM: names only, never values.
# push-env.sh builds the real file from the laptop's .env + .env.local and
# check-env.ts reports each key as set or missing. Keys the app does not read
# are carried along harmlessly.

# --- written by push-env.sh on the server (never copied from the laptop) ---
# required; internal-only values are generated on the server and kept across pushes
NODE_ENV=                          # production
POLYMATH_DB_PASSWORD=              # server-generated; the db volume was initialised with it
DATABASE_URL=                      # postgresql://axiom:<password>@db:5432/axiom
EVE_BRIDGE_SECRET=                 # server-generated, 64 hex chars: app <-> eve run tokens
EVE_GATEWAY_SECRET=                # server-generated, 64 hex chars: eve -> app gateway tokens
APP_ORIGIN=                        # http://localhost:3300 (the tunnel); OAuth callbacks
NEXT_PUBLIC_APP_URL=               # same origin; CORS and absolute links
DOCLING_SERVE_URL=                 # http://docling:5001
SEARXNG_URL=                       # http://searxng:8080
FIRECRAWL_API_URL=                 # http://firecrawl:3002 (self-hosted, no key)
POLYMATH_GATEWAY_URL=              # http://web:3000

# --- from the laptop: required ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # sign-in (read at build time too)
CLERK_SECRET_KEY=                  # sign-in
BLOB_READ_WRITE_TOKEN=             # uploads; production never falls back to local disk

# --- from the laptop: optional, model providers (a missing key hides its models) ---
GROQ_API_KEY=
GEMINI_API_KEY=                    # also the generation and transcription route
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MERCURY_API_KEY=                   # assessor model
THEHIVEAI_API_KEY=
RADIUM_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OVH_API_KEY=
INCEPTION_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
AI_GATEWAY_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
TYPESAFE_API_KEY=                  # Jev classifier
JEV_MONTHLY_INPUT_TOKENS=

# --- from the laptop: optional, connectors ---
COMPOSIO_API_KEY=                  # Notion, Gmail, Slack, GitHub ... connections
COMPOSIO_AUTH_CONFIG_NOTION=       # one COMPOSIO_AUTH_CONFIG_<PROVIDER> per connector
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=

# --- from the laptop: optional, search and extraction ---
SEARCH_PROVIDER=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_HOSTED_API_KEY=
LLAMAPARSE_API_KEY=
REDUCTO_API_KEY=
DEEPGRAM_API_KEY=                  # transcription

# --- optional tuning ---
LOCAL_TZ=                          # server-side date rendering, e.g. America/Los_Angeles
POLYMATH_SUPERAGENT_DECIDE_THRESHOLD=
OUTBOX_WORKER_TICK_MS=

# --- never set on the server ---
# POLYMATH_DEV_AUTH  dev-only sign-in bypass
# TEST_DATABASE_URL  test suites only
# LANGFUSE_*         Langfuse is not deployed here
