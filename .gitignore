# Agent scratch: the SDD workspace (ledger, briefs, review packages) and the
# isolated worktrees spawned for parallel task execution. Neither is source.
.superpowers/
.claude/worktrees/

# Vendored skill tooling (skills.sh installs: e.g. nutlope/hallmark). The
# canonical copy lives in .agents/skills; .claude/skills symlinks to it and
# `agent/` is a duplicate the installer writes for other runtimes. Their
# fixture TS is deliberately broken and must never enter the app build.
# Installed versions are recorded in the tracked skills-lock.json.
# Anchored to the repo root: unanchored, the pattern also matched
# eve/polymath/agent/ — where all 36 files are tracked — and silently
# ignored every NEW eve tool module added there.
/.agents/*
!/.agents/README.md
!/.agents/BRIEF.md
!/.agents/FACTORY.md
!/.agents/conventions/
!/.agents/templates/
/agent/
.claude/skills/
# Hallmark run output: before/after screenshots and wiring records. Evidence
# is uploaded to the PR, not committed (spec: .hallmark/ stays out of the diff).
.hallmark/

# Drizzle snapshots: exactly one is tracked — the newest, matching the
# journal's last entry (see scripts/check-snapshot-invariant.ts and
# src/db/migrations/README.md). Rolling the baseline forward: flip the
# exception to the new snapshot, `git add -f` it, and `git rm --cached`
# the old one.
src/db/migrations/meta/*_snapshot.json
!src/db/migrations/meta/0290_snapshot.json

# graphify knowledge graph (local build artifacts)
graphify-out/

# Retrieval eval run outputs (run locally against a scratch DB)
evals/retrieval/results/
