{
  "mcpServers": {
    "serena": {
      "command": "/Users/ashwin/.local/bin/serena",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "/Users/ashwin/Projects/axiom"
      ],
      "env": {
        "MCP_TIMEOUT": "60000"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "gmail": {
      "type": "http",
      "url": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "code-index": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "code-index-mcp",
        "code-index-mcp"
      ],
      "env": {}
    }
  }
}