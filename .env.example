# Copy to .env and fill in. Never commit .env — .gitignore covers it.

# Neon Postgres. Required by src/lib/db.ts and drizzle.config.ts.
# Get it from the Neon console: Connection Details → Pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional. The integration tests run only when this is set, so a clone without
# a database skips them instead of failing.
#
# Never point this at DATABASE_URL. The suite truncates every table in the
# public schema before it runs. Use a scratch database or a throwaway Neon
# branch, and apply migrations first (pnpm db:migrate).
TEST_DATABASE_URL=""

# Clerk. Both are optional locally: src/proxy.ts skips auth when either is
# absent, so the app still boots without a Clerk project. Both or neither.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Document extraction (src/integrations/extraction/). The first one set wins:
# docling-serve in docker locally (docker compose up docling), else LlamaParse
# hosted (free tier, works from Vercel).
DOCLING_SERVE_URL=""
LLAMAPARSE_API_KEY=""

# Embeddings for semantic search over extracted text (text-embedding-3-small, 1536 wide).
# Without it documents still extract; chunks are simply not written.
OPENAI_API_KEY=""

# Shared by the app and the Eve agent: signs the short-lived token that carries the
# signed-in user and workspace to Eve. 32+ characters, e.g. `openssl rand -hex 32`.
# Without it POST /api/v1/runs answers 503 and no run starts.
EVE_BRIDGE_SECRET=""

# Vercel Blob (binary storage for uploads). `vercel env pull` fills this on a
# linked project; uploads fail without it.
BLOB_READ_WRITE_TOKEN=""

# Embeddings: OpenRouter (preferred) or OpenAI. EMBEDDING_PROVIDER=openrouter|openai picks one explicitly.
# EMBEDDING_MODEL overrides the OpenRouter model; it must support dimensions=1536.
OPENROUTER_API_KEY=
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Local research stack (`make search-up`): SearXNG + Firecrawl in compose.
# SEARCH_PROVIDER=searxng routes the agents' web.search through the local
# instance. Without SEARXNG_URL the resolver falls back to keyed providers or
# DuckDuckGo, so these stay unset until the stack is running.
SEARCH_PROVIDER=searxng
SEARXNG_URL="http://127.0.0.1:8080"

# Firecrawl. FIRECRAWL_API_URL points at the local compose service; the key is
# optional locally (the self-hosted instance authenticates nobody) and required
# only when you point it at a hosted instance instead.
FIRECRAWL_API_URL="http://127.0.0.1:3002"
FIRECRAWL_API_KEY=""

# Composio (connect Google Calendar / Notion). Create one auth config per toolkit in the Composio dashboard.
# COMPOSIO_API_KEY=
# COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
# COMPOSIO_AUTH_CONFIG_NOTION=
# APP_ORIGIN=https://your-deployment.example   # OAuth callback origin
