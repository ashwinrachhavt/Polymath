{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/understanding-hook.mjs\"",
            "if": "Bash(git commit *)",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/understanding-hook.mjs\"",
            "if": "Bash(git push *)",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
