#!/bin/sh
# Pre-commit gate: staged-file lint and format, plus a guard for CI flakes that
# only appear on remote runs (agents/engineering.md: a bug fixed twice is a
# rule). Fast checks only — the correctness layers (typecheck, related unit
# tests) run further down, and build and e2e run in CI.
# Set core.hooksPath to scripts/hooks to install:
#   git config core.hooksPath scripts/hooks
set -e

fails=0

# No oversized files: a stray snapshot, dump, recording or build output bloats
# the repo forever once pushed. 1 MB comfortably fits the tracked drizzle
# snapshot (~0.7 MB) and the lockfile. Override for one commit with
# ALLOW_LARGE_FILES=1 if a large file is genuinely intended.
if [ "${ALLOW_LARGE_FILES:-0}" != "1" ]; then
  large=$(git diff --cached --name-only --diff-filter=AM | while IFS= read -r f; do
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt 1048576 ]; then printf '  %s (%s KB)\n' "$f" "$((size / 1024))"; fi
  done || true)
  if [ -n "$large" ]; then
    echo "ERROR: staged files over 1 MB:" >&2
    printf '%s\n' "$large" >&2
    echo "Unstage them (git restore --staged <file>), or set ALLOW_LARGE_FILES=1 if intended." >&2
    fails=1
  fi
fi

# Lint and format the files actually going into this commit. Whole-tree lint
# here would be too slow to live in a commit, so CI's check-lint leg keeps
# the full `pnpm lint` gate. Skipped silently when prettier is not yet
# installed so the hook never blocks on a missing tool.
# Null-delimited throughout: these paths carry spaces and parentheses
# (src/app/(workspace)/...), which a whitespace-splitting xargs would shred.
if command -v npx >/dev/null 2>&1 && [ -x node_modules/.bin/prettier ]; then
  # xargs -r: with nothing staged for a step, don't boot the tool at all —
  # an argument-less npx prettier/eslint still pays its full startup, which
  # is exactly what docs-only commits must not pay.
  git diff --cached -z --name-only --diff-filter=ACM \
    | grep -zE '\.(js|jsx|ts|tsx|mjs|cjs|json|md|css)$' \
    | xargs -0 -r npx prettier --write --ignore-unknown --log-level warn || fails=1
  # Re-stage what prettier rewrote so the commit carries the formatted bytes.
  git diff --cached -z --name-only --diff-filter=ACM \
    | grep -zE '\.(js|jsx|ts|tsx|mjs|cjs|json|md|css)$' \
    | xargs -0 -r git add -- || fails=1
fi

if [ -x node_modules/.bin/eslint ]; then
  # --max-warnings=0 keeps a warning from quietly becoming the new normal;
  # CI's `pnpm lint` fails the same way.
  # --no-warn-ignored: the config deliberately ignores some trees (extensions/,
  # vendored libs). Naming one of those files explicitly makes eslint emit a
  # "file ignored" warning, which --max-warnings=0 fails — so no commit under
  # an ignored path could ever pass this hook. Whole-tree lint (CI) skips
  # ignored files silently; this hook skips them the same way. Real findings
  # in staged source still fail the commit.
  git diff --cached -z --name-only --diff-filter=ACM \
    | grep -zE '\.(js|jsx|ts|tsx|mjs|cjs)$' \
    | xargs -0 -r npx eslint --max-warnings=0 --no-warn-ignored || fails=1
fi

# The app renders two <main> elements (shell content main plus the route
# loading skeleton), so a bare page.locator("main") resolves to 2 elements
# and fails CI under strict mode. Scope to "#content".
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.spec\.ts$'; then
  if git diff --cached --name-only --diff-filter=ACM | grep -q '^tests/e2e/'; then
    if git diff --cached -U0 -- 'tests/e2e/*.spec.ts' | grep -E '^\+' | grep -qE 'locator\("main"\)|locator\(.(main).\)' ; then
      echo "ERROR: bare locator(\"main\") in e2e tests. Two <main> elements render (shell #content + route loading skeleton); scope to locator(\"#content\")." >&2
      fails=1
    fi
  fi
fi

# The correctness layers that used to live in the pre-push gate: typecheck and
# the unit tests related to what is staged. They run only when a staged file
# can affect them — a docs/markdown-only commit skips the whole block. The db
# project stays out of the commit path on purpose: no database exists at
# commit time, and those invariants are CI's check-tests-db leg.
# Null-delimited like everything above, and guarded on an installed toolchain
# so the hook never blocks on a missing dependency.
if [ -x node_modules/.bin/vitest ] && [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' 'tsconfig*.json' 'package.json')" ]; then
  # Whole-tree by nature: tsc checks the program, not the patch — a staged
  # edit can break an unstaged consumer, and a red commit beats a green push
  # that dies in CI. Incremental state (tsconfig.tsbuildinfo) keeps the warm
  # run at seconds; the first run of the day pays the cold build.
  pnpm typecheck || fails=1
  # Unit project only: `vitest related` maps the staged files to the tests
  # that import them, and --passWithNoTests keeps a file with no related unit
  # tests (e.g. an integration suite) from failing the commit.
  git diff --cached -z --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' 'tsconfig*.json' 'package.json' \
    | xargs -0 -r npx vitest related --run --project unit --passWithNoTests || fails=1
fi

exit $fails
