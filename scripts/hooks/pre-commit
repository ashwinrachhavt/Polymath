#!/bin/sh
# Pre-commit gate: staged-file lint and format, plus a guard for CI flakes that
# only appear on remote runs (agents/engineering.md: a bug fixed twice is a
# rule). Fast checks only — typecheck runs at pre-push, build and e2e in CI.
# Set core.hooksPath to scripts/hooks to install:
#   git config core.hooksPath scripts/hooks
set -e

fails=0

# Lint and format the files actually going into this commit. Whole-tree lint
# here would be too slow to live in a commit, so pre-push keeps the full
# `pnpm lint && pnpm typecheck` gate. Skipped silently when prettier is not yet
# installed so the hook never blocks on a missing tool.
# Null-delimited throughout: these paths carry spaces and parentheses
# (src/app/(workspace)/...), which a whitespace-splitting xargs would shred.
if command -v npx >/dev/null 2>&1 && [ -x node_modules/.bin/prettier ]; then
  git diff --cached -z --name-only --diff-filter=ACM \
    | grep -zE '\.(js|jsx|ts|tsx|mjs|cjs|json|md|css)$' \
    | xargs -0 npx prettier --write --ignore-unknown --log-level warn || fails=1
  # Re-stage what prettier rewrote so the commit carries the formatted bytes.
  git diff --cached -z --name-only --diff-filter=ACM \
    | grep -zE '\.(js|jsx|ts|tsx|mjs|cjs|json|md|css)$' \
    | xargs -0 git add -- || fails=1
fi

if [ -x node_modules/.bin/eslint ]; then
  # --max-warnings=0 keeps a warning from quietly becoming the new normal;
  # CI's `pnpm lint` fails the same way.
  git diff --cached -z --name-only --diff-filter=ACM \
    | grep -zE '\.(js|jsx|ts|tsx|mjs|cjs)$' \
    | xargs -0 npx eslint --max-warnings=0 || fails=1
fi

# The app renders two <main> elements (shell content main plus the route
# loading skeleton), so a bare page.locator("main") resolves to 2 elements
# and fails CI under strict mode. Scope to "#content".
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.spec\.ts$'; then
  if git diff --cached --name-only --diff-filter=ACM | grep -q '^tests/e2e/'; then
    if git diff --cached -U0 -- 'tests/e2e/*.spec.ts' | grep -E '^\+' | grep -qE 'locator\("main"\)|locator\(.(main).\)'; then
      echo "ERROR: bare locator(\"main\") in e2e tests. Two <main> elements render (shell #content + route loading skeleton); scope to locator(\"#content\")." >&2
      fails=1
    fi
  fi
fi

exit $fails
