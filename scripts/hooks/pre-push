#!/bin/sh
# Pre-push gate for the CI split (perf: a red lint/typecheck push costs a full
# CI round trip across three parallel legs; locally it costs ~90s). Fast checks
# only — build, tests, and e2e stay in CI. Installed via the prepare script:
#   git config core.hooksPath scripts/hooks
# A non-zero exit aborts the push.
set -e

# A bare pnpm binary is the normal case (standalone installs, setup-pnpm);
# corepack-only environments still need the gate, so fall back instead of
# aborting the push on a missing shim.
PNPM="pnpm"
command -v pnpm >/dev/null 2>&1 || PNPM="corepack pnpm"

$PNPM lint && $PNPM typecheck
