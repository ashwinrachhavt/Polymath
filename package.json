{
  "name": "polymath",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "bench:search": "tsx scripts/bench-search.ts",
    "backfill:semantic-edges": "tsx --env-file=.env scripts/backfill-semantic-edges.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/pre-migrate-guard.ts && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:personal": "tsx --env-file=.env scripts/seed/companies.ts",
    "seed:parties": "tsx --env-file=.env scripts/seed/parties.ts",
    "seed:inventory": "tsx --env-file=.env scripts/seed/inventory.ts",
    "companion:pair": "tsx --env-file=.env scripts/pair-companion.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm inventory:check && pnpm build",
    "prepare": "git config core.hooksPath scripts/hooks",
    "seed:taxonomy": "tsx --env-file=.env scripts/seed-taxonomy.ts",
    "inventory": "tsx scripts/tech-spec-inventory.ts",
    "inventory:check": "tsx scripts/tech-spec-inventory.ts --check"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "7.9.21",
    "@excalidraw/excalidraw": "^0.18.1",
    "@langchain/langgraph": "^1.6.0",
    "@langfuse/client": "^5.14.0",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vantezzen/langfuse-eve": "0.1.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.159",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "0.45.4",
    "eve": "^0.76.3",
    "lucide-react": "^1.66.0",
    "modern-tar": "0.8.6",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@langchain/langgraph-cli": "^1.5.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "just-bash": "^3.6.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  }
}
