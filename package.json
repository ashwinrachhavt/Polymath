{
  "name": "polymath",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/pre-migrate-guard.ts && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:personal": "tsx --env-file=.env scripts/seed/companies.ts",
    "seed:parties": "tsx --env-file=.env scripts/seed/parties.ts",
    "seed:inventory": "tsx --env-file=.env scripts/seed/inventory.ts",
    "stones:generate": "tsx --env-file=.env scripts/stones/generate.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:registry": "tsx scripts/check-audit-registry.ts",
    "check:snapshot-invariant": "tsx scripts/check-snapshot-invariant.ts",
    "check:repo-hygiene": "tsx scripts/check-repo-hygiene.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:registry && pnpm build",
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "seed:taxonomy": "tsx --env-file=.env scripts/seed-taxonomy.ts",
    "polymath-mcp": "node plugins/polymath/mcp/server.mjs",
    "knip": "DATABASE_URL='postgresql://knip:unused@127.0.0.1:9/knip_never_connects' knip",
    "test:ci": "sh scripts/reset-test-db.sh && vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "7.9.21",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "3.4.0",
    "@sentry/nextjs": "11.12.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vantezzen/langfuse-eve": "0.1.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "eve": "^0.76.3",
    "lucide-react": "^1.68.0",
    "mermaid": "12.3.0",
    "modern-tar": "0.8.6",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "knip": "^6.44.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "undici@>=8.0.0 <8.12.2": "8.12.2",
    "nanoid@>=3.0.0 <3.3.18": "3.3.20",
    "nanoid@>=4.0.0 <5.1.16": "5.1.16",
    "lodash-es@>=4.0.0 <4.18.1": "4.18.1",
    "katex@>=0.11.0 <0.18.2": "0.18.2",
    "esbuild@~0.18.20": "0.25.12",
    "zod@>=4.0.0 <4.6.6": "4.6.7"
  }
}
